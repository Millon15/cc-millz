{
  "type": "object", "additionalProperties": false, "required": ["links"],
  "properties": {
    "links": {
      "type": "array", "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["index", "target", "relation"],
        "properties": {
          "index": {"type": "integer", "minimum": 0, "maximum": 4},
          "target": {"type": "string", "pattern": "^lsn-[0-9a-f]{64}$"},
          "relation": {"type": "string", "enum": ["same", "refines", "contradicts", "different"]}
        }
      }
    }
  }
}
