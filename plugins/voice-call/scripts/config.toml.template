# voice-call settings for this machine.
# Path: ~/.config/voice-call/config.toml ($XDG_CONFIG_HOME/voice-call/config.toml, or $VOICE_CALL_CONFIG).
# Order, last wins: built-in defaults, this file, a repo's .voice-call.json.
# Read when the daemon starts: after an edit, hang up (Option+Cmd+Shift+V) and press Option+Cmd+V again.
# `voice-call --explain` shows every value and where it came from.

# The voice is fixed for the whole call. Built-in default: "ripple".
voice = "ripple"

# backend = "auto"          # auto (GPT-Live, Realtime fallback) | gpt-live | realtime
# model = "gpt-live-1"
# brain_model = "gpt-5.6"
# idle_hangup_min = 15      # 1 to 120

